# Azure DDNS — Configuration
# Copy this file to az-ddns.conf and fill in your values.
# az-ddns.conf is git-ignored — never commit real credentials.

# REQUIRED: Azure resource group containing your DNS zone
AZ_RESOURCE_GROUP=changeme

# Azure DNS zone and record
AZ_DNS_ZONE=changeme.example.com
AZ_RECORD_NAME=@
AZ_RECORD_TTL=300

# Log file (comment out to log to stdout/stderr only)
# LOG_FILE=/var/log/az-ddns.log

# IP check — defaults to bundled az-ddns-ip.sh. Override with any command
# that writes a plain IPv4 address to stdout.
# IP_SERVICE_COMMAND=/usr/local/bin/az-ddns-ip.sh
# IP_SERVICE_COMMAND="curl -s ifconfig.me"
# IP_SERVICE_COMMAND="dig +short myip.opendns.com @resolver1.opendns.com"
IP_SERVICE_URL=https://api.ipify.org

# State file to track last known IP (prevents unnecessary updates)
STATE_FILE=/var/lib/az-ddns/last_ip.txt

# ── Azure Service Principal (alternative to mounting ~/.azure) ──
# Create one with:
#   az ad sp create-for-rbac --name az-ddns-sp \
#     --role "DNS Zone Contributor" \
#     --scopes /subscriptions/YOUR_SUB_ID/resourceGroups/YOUR_RG
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Polling interval in seconds (Docker only)
INTERVAL=300
