{
    "version": "2.0",
    "logging": {
        "logLevel": {
            "default": "Information",
            "AzDdns": "Information"
        },
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "http": {
            "routePrefix": "api"
        }
    }
}
