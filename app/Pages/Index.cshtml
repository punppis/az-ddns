@page
@model AzDdns.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">az-ddns Dashboard</h2>

@if (Model.GuiAuthEnabled && User.Identity?.IsAuthenticated != true)
{
    <div class="alert alert-warning">
        You are not signed in. <a asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">Sign in with Microsoft</a> to use the dashboard.
    </div>
    return;
}

@if (!Model.GuiAuthEnabled)
{
    <div class="alert alert-info">
        GUI authentication is not configured (<code>AZURE_APP_CLIENT_ID</code> not set). Running in API-only mode.
    </div>
}

@if (TempData["UpdateMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["UpdateError"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Update form -->
<div class="card mb-4">
    <div class="card-header">Update DNS Records</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Update">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label for="ipOverride" class="form-label">IP Address Override</label>
                    <input type="text" class="form-control" id="ipOverride" name="ipOverride"
                           placeholder="Leave blank to use your current IP" />
                    <div class="form-text">Leave empty to use your detected public IP.</div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Update All Domains</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Domain status table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Managed Domains</span>
        <a asp-page="/Domains/Index" class="btn btn-sm btn-outline-secondary">Manage Domains</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Domains.Any())
        {
            <p class="text-muted p-3 mb-0">No domains configured. <a asp-page="/Domains/Index">Add one</a>.</p>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Domain</th>
                        <th>Current IP</th>
                        <th>Last Updated</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Domains)
                    {
                        <tr>
                            <td><code>@d.Domain</code></td>
                            <td>@(d.CurrentIp ?? "—")</td>
                            <td>@(d.LastUpdated.HasValue ? d.LastUpdated.Value.ToString("u") : "—")</td>
                            <td>
                                @if (d.Error is not null)
                                {
                                    <span class="status-err fw-semibold">✘ Error: @d.Error</span>
                                }
                                else if (!d.LastFetched.HasValue)
                                {
                                    <span class="status-wait fw-semibold">⏳ Fetching…</span>
                                }
                                else
                                {
                                    <span class="status-ok fw-semibold">✔ OK</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
